# copy to .env and change these
NURZING_DATABASE_URL=sqlite:///./nurzing.db
NURZING_JWT_SECRET=change-me-to-a-long-random-string
NURZING_JWT_TTL_MINUTES=43200
NURZING_OTP_TTL_SECONDS=300
NURZING_OTP_DEBUG=true          # return the OTP in the API response (dev only!)
NURZING_CORS_ORIGINS=http://localhost:5173,https://nurzing.pages.dev
NURZING_ADMIN_PHONES=+919180000000
