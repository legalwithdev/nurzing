# ---- core ----
NURZING_DATABASE_URL=sqlite:///./nurzing.db
NURZING_JWT_SECRET=change-me-to-a-long-random-string
NURZING_JWT_TTL_MINUTES=43200
NURZING_OTP_TTL_SECONDS=300
NURZING_OTP_DEBUG=true                 # dev only: returns the OTP in the response
NURZING_CORS_ORIGINS=http://localhost:5173,https://nurzing.pages.dev
NURZING_ADMIN_PHONES=+919180000000
NURZING_GOLD_MIN_YEARS=7

# ---- payments (dummy = local dev, never moves money) ----
NURZING_PAYMENT_PROVIDER=dummy         # dummy | razorpay
NURZING_RAZORPAY_KEY_ID=
NURZING_RAZORPAY_KEY_SECRET=
NURZING_RAZORPAY_WEBHOOK_SECRET=

# ---- sms (console = prints, msg91 = real) ----
NURZING_SMS_PROVIDER=console           # console | msg91
NURZING_MSG91_AUTHKEY=
NURZING_MSG91_SENDER=NURZNG
NURZING_MSG91_TEMPLATE_ID=

# ---- uploads ----
NURZING_UPLOAD_DIR=./uploads
NURZING_MAX_UPLOAD_BYTES=5242880
NURZING_ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,application/pdf

# ---- rate limiting ----
NURZING_RATE_LIMIT_PER_MINUTE=60
NURZING_RATE_LIMIT_AUTH_PER_MINUTE=10

# ---- storage backend ----
NURZING_STORAGE_BACKEND=local          # local | s3
NURZING_S3_BUCKET=
NURZING_S3_REGION=ap-south-1
NURZING_S3_ENDPOINT=
NURZING_S3_ACCESS_KEY=
NURZING_S3_SECRET_KEY=
NURZING_S3_PUBLIC_BASE=

# ---- queue ----
NURZING_REDIS_URL=                     # empty -> database-backed queue
